{
  "name": "devlogin",
  "version": "1.0.0",
  "description": "Node.js CRUD task application with authentication, used for the DevOps CI/CD assignment. The package name stays \"devlogin\" to match the systemd service, /opt path, metric prefix and the devlogin.nextastra.com hostname.",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "start:local": "node --env-file=.env server.js",
    "dev": "node --watch --env-file=.env server.js",
    "test": "jest --runInBand --forceExit",
    "test:ci": "jest --runInBand --forceExit --ci --reporters=default --reporters=jest-junit",
    "lint": "eslint .",
    "build": "node scripts/build.js"
  },
  "keywords": [
    "devops",
    "jenkins",
    "nginx",
    "prometheus"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "coverageDirectory": "coverage",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "jest-junit": {
    "outputDirectory": "reports",
    "outputName": "junit.xml"
  }
}
