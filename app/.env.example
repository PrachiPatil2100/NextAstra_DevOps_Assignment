# Local development:
#   cp .env.example .env   then   npm run dev   (or npm run start:local)
#   Those scripts pass --env-file=.env to Node, which reads this file natively.
#
# Production:
#   copy to /etc/devlogin/devlogin.env and point systemd's EnvironmentFile= at
#   it. `npm start` deliberately does NOT read .env — the environment supplies
#   the values.
#
# Never commit the populated file (.env is gitignored).

NODE_ENV=production
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Signing key for session JWTs. Generate with:  openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32
TOKEN_TTL=1h

# Demo accounts created at boot.
ADMIN_USER=admin
ADMIN_PASSWORD=replace-me
DEV_USER=developer
DEV_PASSWORD=replace-me
